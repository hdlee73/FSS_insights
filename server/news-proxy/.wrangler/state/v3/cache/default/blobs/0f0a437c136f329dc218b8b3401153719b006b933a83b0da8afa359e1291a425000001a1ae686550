// 소관부서 selectbox 그리기
function displayDepartment(deptNo) {
	// 선택하세요 선택 시 아무것도 안함
	if(deptNo == '') return;
	
	let childrenCount = $('#department').children().length;

	// parameter 설정
	let params = new Object();
	if(childrenCount == 0) {
		params.deptNo = $("#searchDpNo").val();
	} else {
		params.deptNo = deptNo;
	}
	
	// 서버에 요청
	$.ajax({
		url : "/fsc_new/status/adminMap/getDeptTree.do",
		method : 'POST',
		dataType : 'json',
		data :  params,
		success : function(data) {
			addDepartment(childrenCount + 1, data.depLst);
		},
		error : function(jqXhr, textStatus, message) {
			alert("error : " + message);
		}
	});
	
}

// 하위에 부서 selectbox 추가
function addDepartment(depth, depLst) {

	if(typeof depLst == 'undefined') 
		return;
	if(depth > 3)
		return;
	if(depLst.length == 0)
		return;
	
	var title = "";
	if(depth == "1"){
		title = "담당부서 분류1";
	}else if(depth == "2"){
		title = "담당부서 분류2";
	}else if(depth == "3"){
		title = "담당부서 분류3";
	}
	
	let html = '<select id="searchDpNo'+ depth +'" class="input-text ml5 dynaDept" name="" style="width:140px; padding-right: 40px;" title="'+title+'">';
	html += '		<option value="">선택하세요.</option>';
	
	for(var i=0; i < depLst.length; i++) {
		html += '	<option value="'+ depLst[i].deptNo +'">'+ depLst[i].deptName +'</option>';
	}
	
	$('#department').append(html);
}

