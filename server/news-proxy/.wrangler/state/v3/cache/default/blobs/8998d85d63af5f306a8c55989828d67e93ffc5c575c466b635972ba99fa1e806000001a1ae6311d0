				}
				, error: function(response, text){ }
			});
		}

		function fnAddDstReport(reportData){
			if(reportData && typeof reportData == 'object'){
				var data;
				var html;

				if(reportItemTemplate === null){
					reportItemTemplate = Handlebars.compile($("#tagReportItem").html());
				}
				var tagList = reportData.tag_list || [];
				for (var ti = 0; ti < tagList.length; ti++) {
					if (tagList[ti]) {
						tagList[ti].tag_title_enc = encodeURIComponent(tagList[ti].tag_title || '');
					}
				}
				data = {
					'report_no':reportData.report_no,
					'img_src':reportData.img_src,
					'report_title':reportData.report_title,
					'report_num':reportData.report_num,
					'author':reportData.author,
					'pub_date':reportData.pub_date,
					'summary':reportData.summary,
					'report_pdf_download_link':reportData.report_pdf_download_link,
					'report_pdf_preview_link':reportData.report_pdf_preview_link,
					'report_bodo_download_link':reportData.report_bodo_download_link,
					'report_bodo_preview_link':reportData.report_bodo_preview_link,
					'tag_list':tagList,
					'displayset':reportData.displayset,
					'bodo_displayset':reportData.bodo_displayset
				};
				html = reportItemTemplate(data);
				$(".report_list-box").append(html);
				// 각 게시물 해시태그 노출 여부를 스크립트에서 제어
				kcmiUi.mobInitTag();
			}
		}

		function fnSearch(gubun, obj){
			setCookie("rsidx", "", 0);
			$("#thisPage").val(1);
			var s_report_type = reportType;
			var s_report_subject = reportSubject;
			if(gubun == 's_report_type'){
				s_report_type = $(obj).val();
			}else if(gubun == 's_report_subject'){
				s_report_subject = $(obj).attr("data_value") ? $(obj).attr("data_value") : "";
			}

			location.href = window.location.pathname+"?s_report_type="+encodeURIComponent(s_report_type)+"&s_report_subject="+encodeURIComponent(s_report_subject);
		}

		function getCookie(name){
			var nameOfCookie = name + "=";
			var x = 0;
			while ( x <= document.cookie.length ){
				var y = (x+nameOfCookie.length);
				if ( document.cookie.substring( x, y ) == nameOfCookie ) {
					if ( (endOfCookie=document.cookie.indexOf( ";", y )) == -1 ) endOfCookie = document.cookie.length;
					return unescape( document.cookie.substring( y, endOfCookie ) );
				}
				x = document.cookie.indexOf( " ", x ) + 1;
				if ( x == 0 )
					break;
			}
			return "";
		}

		function setCookie( name, value, expiredays ){
			var todayDate = new Date();
			todayDate.setDate( todayDate.getDate() + expiredays );
			if (expiredays != 0) document.cookie = name + "=" + escape( value ) + ";path=/;expires=" + todayDate.toGMTString() + ";"
			else document.cookie = name + "=" + escape( value ) + ";path=/;"
		}
        function viewpage(idx,u,t,p){
			var
				stype = $('#stype').val(),
				skey = $('#skey').val(),
				thisPage = $("#thisPage").val();

			setCookie("rsidx", idx, 0);
			history.pushState(null, null, location.pathname+"?thispage="+encodeURIComponent(thisPage));
            if(u!="") u = u+"?report_no="+encodeURIComponent(idx)+"&"+reportParamStr+"&thispage="+encodeURIComponent(thisPage);
            if(t=='_blank') window.open(u);
            else location.href = u;
		}

        //앵커이동
		function moveTag(id){
			var tag = document.getElementById(id);
			var pos_y = 0;
			var obj = tag;

			if(obj != null){
				while(obj.offsetParent){
				    pos_y += parseInt(obj.offsetTop);
				    obj = obj.offsetParent;
				}
				pos_y += parseInt(obj.offsetTop);
				pos_y -= parseInt(tag.offsetHeight);
				document.documentElement.scrollTop = pos_y;

			}

		}

        $(document).ready(function() {

            var HashLocationName = document.location.hash;
			//console.log('HashLocationName',HashLocationName);
			if(HashLocationName != ''){
				document.location.hash = '';
				HashLocationName = HashLocationName.replaceAll("#", "");
				location.href = './report_list' + HashLocationName;
			}

            var rsidx = getCookie("rsidx");
			//console.log('rsidx',rsidx);
			//console.log(document.referrer);
			if ( document.referrer.match(/\/report\/(report_view|report_list)/i)) {
				//console.log(document.referrer);
				//여기에 걸리면 view갔다가 돌아온 페이지만 자동이동한다 / 스크롤 내린거 기억
				if(rsidx != "" && tPageParam>0){					
					moveTag("rsidx_"+rsidx);
				}			
			}
        });

		function endlist(value) {
			if(value){
				location.href="./report_list?s_report_type=" +value;
			}
		}
