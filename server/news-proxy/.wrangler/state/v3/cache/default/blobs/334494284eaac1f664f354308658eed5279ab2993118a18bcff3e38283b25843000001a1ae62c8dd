	<script>
	window.addEventListener("load", function () {
	
	    const lnb = document.querySelector(".lnb");
	    
	    if (!lnb) return;
	    
	    const depth2Menus = lnb.querySelectorAll("ul > li");
	    
	    depth2Menus.forEach(function(li) {
	       
	    	const a = li.querySelector("a");
	        const subMenu = li.querySelector("ul");
	
	        // 실제 하위메뉴 있는지 체크 (핵심)
	        const hasRealSubMenu = subMenu && subMenu.children.length > 0;
	       
	        if (a && hasRealSubMenu) {
	            a.classList.add("has-submenu");
	            a.setAttribute("aria-haspopup", "true");
	          
	            if (li.classList.contains("active")) {
	                a.setAttribute("aria-expanded", "true");
	                a.setAttribute("aria-label", "확장됨");
	            } else {
	                a.setAttribute("aria-expanded", "false");
	                a.setAttribute("aria-label", "축소됨");
	            }
	
	            // 클릭 (하위메뉴 있을 때만 막기)
	            a.addEventListener("click", function(e) {
	                e.preventDefault();
	               
	                const expanded = a.getAttribute("aria-expanded") === "true";
	                
	                a.setAttribute("aria-expanded", !expanded);
	                a.setAttribute("aria-label", !expanded ? "확장됨" : "축소됨");
	            });
	
	            // 키보드 접근성 (추가 but 안전)
	            a.addEventListener("keydown", function(e) {
	                if (e.key === "Enter" || e.key === " " || e.key === "Spacebar") {
	                    e.preventDefault();
	
	                    const expanded = a.getAttribute("aria-expanded") === "true";
	
	                    a.setAttribute("aria-expanded", !expanded);
	                    a.setAttribute("aria-label", !expanded ? "확장됨" : "축소됨");
	                }
	            });
	        }
	    });
	});
</script>
	
